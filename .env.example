# ============================================================
# MeetGraph 智能会议助手 - 环境变量模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# 所有外部集成都是可选项：缺配置时对应能力自动降级，不影响服务启动
# ============================================================

# ---------- LLM API ----------
# MiniMax API (推荐，支持中文)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_group_id_here
MINIMAX_MODEL=abab6.5s-chat

# OpenAI API (备选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ---------- 语音转写 ----------
# Whisper 配置
WHISPER_MODEL_SIZE=large-v2
WHISPER_LANGUAGE=zh
WHISPER_DEVICE=cpu
# 说话人识别（pyannote）所需的 HuggingFace Token；留空则只转写、不做说话人分离
HF_TOKEN=

# ---------- Jira 集成 ----------
JIRA_SERVER=https://your-company.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=MEET
# 人员映射：会议里的显示名 → Jira 账号。
# 优先级：JIRA_USER_MAP（内联 JSON）> JIRA_USER_MAP_FILE（文件路径）> config/jira_users.json
JIRA_USER_MAP=
JIRA_USER_MAP_FILE=

# ---------- 飞书集成 ----------
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_token

# ---------- 运行配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=info
# 会议报告输出目录，留空则用 <仓库>/reports
REPORTS_DIR=
# 同步幂等台账（SQLite）路径，留空则用 <仓库>/data/sync-ledger.db
SYNC_LEDGER_DB=

# ---------- 知识库检索（RAG） ----------
# 向量后端：auto（默认，先试本地 BGE）/ hash（离线，无需模型）/ openai（走接口）
RAG_EMBEDDER=auto
# 本地向量模型；留空则用 BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_MODEL=
# 走 openai 后端时的接口地址与密钥（兼容 /embeddings 协议）
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
# 索引目录 / 语料目录（逗号分隔）/ 术语表路径
RAG_INDEX_DIR=
RAG_CORPUS_DIRS=
RAG_GLOSSARY=
# 设为 0 可关闭 HuggingFace 镜像自动切换（默认走 hf-mirror.com）
RAG_HF_MIRROR=1
